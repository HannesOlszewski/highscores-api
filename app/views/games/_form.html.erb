<%= form_with model: game, class: "form" do |form| %>
  <% if form.object.errors.any? %>
    <div class="form-error" role="alert">
      <% form.object.errors.full_messages.each do |message| %>
        <p><%= message %>.</p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, class: "mono", required: true, autofocus: true, autocomplete: "off", spellcheck: false,
          pattern: "[A-Za-z0-9_\\-]+", maxlength: 64, aria: { describedby: "name-hint" } %>
    <p class="hint" id="name-hint">
      Letters, numbers, dashes and underscores. The name is part of the API URL, for example
      <code>/games/space-invaders/scores</code>.
      <% if game.persisted? %>Renaming changes that URL, so update any game builds that use the old one.<% end %>
    </p>
  </div>

  <div class="form-actions">
    <%= form.submit submit_label, class: "button button-primary" %>
    <%= link_to "Cancel", cancel_path, class: "button button-quiet" %>
  </div>
<% end %>
