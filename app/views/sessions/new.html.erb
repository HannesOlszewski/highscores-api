<% content_for :title, "Sign in" %>
<% content_for :page_class, "page-narrow" %>

<div class="panel">
  <h1>Sign in</h1>
  <p>Manage your games and their leaderboards.</p>

  <%= form_with url: session_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>

    <div class="form-actions">
      <%= form.submit "Sign in", class: "button button-primary" %>
    </div>
  <% end %>
</div>

<p class="below-panel"><%= link_to "Forgot your password?", new_password_path %></p>
