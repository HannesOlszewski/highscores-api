<% content_for :title, "Choose a new password" %>
<% content_for :page_class, "page-narrow" %>

<div class="panel">
  <h1>Choose a new password</h1>
  <p>You'll be signed out everywhere else.</p>

  <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Repeat new password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="form-actions">
      <%= form.submit "Save password", class: "button button-primary" %>
    </div>
  <% end %>
</div>
