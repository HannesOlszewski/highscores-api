<% content_for :title, "Reset password" %>
<% content_for :page_class, "page-narrow" %>

<div class="panel">
  <h1>Reset your password</h1>
  <p>Enter your email address to get a link for choosing a new password.</p>

  <%= form_with url: passwords_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>

    <div class="form-actions">
      <%= form.submit "Email reset link", class: "button button-primary" %>
      <%= link_to "Back to sign in", new_session_path, class: "button button-quiet" %>
    </div>
  <% end %>
</div>
